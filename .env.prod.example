# ════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT TEMPLATE (Docker / VPS)
# Copy to .env.prod and fill in your values:
#   cp .env.prod.example .env.prod
# ════════════════════════════════════════════════════

# ════════════════════════════════════════════════════
# CORE
# ════════════════════════════════════════════════════
NODE_ENV=production
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info
NEXT_PUBLIC_LOG_LEVEL=warn
# Platform brand name — appears in emails, notifications, and admin UI
APP_NAME=Safarnama
## NEXT_PUBLIC_APP_NAME removed — APP_NAME (above) is the single source of truth

# ════════════════════════════════════════════════════
# DOMAIN & NETWORKING
# ════════════════════════════════════════════════════
SERVER_NAME=your-domain.com
DOMAIN=your-domain.com
ACME_EMAIL=you@email.com
CLIENT_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ════════════════════════════════════════════════════
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://travel:CHANGE_ME_STRONG_PASSWORD@postgres:5432/travel?schema=public
DIRECT_URL=postgresql://travel:CHANGE_ME_STRONG_PASSWORD@postgres:5432/travel?schema=public

# ════════════════════════════════════════════════════
# AUTH (JWT & Google OAuth)
# ════════════════════════════════════════════════════
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_LONG_SECRET
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Required by Next.js frontend for Google sign-in button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ════════════════════════════════════════════════════
# FIREBASE (Phone Auth)
# ════════════════════════════════════════════════════
# Server SDK — used by API only
PHONE_AUTH_STRATEGY=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Client SDK — used by Next.js frontend only
NEXT_PUBLIC_PHONE_AUTH_STRATEGY=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ════════════════════════════════════════════════════
# REDIS (Upstash)
# ════════════════════════════════════════════════════
# Format: rediss://default:<password>@<host>.upstash.io:6380
REDIS_URL=rediss://default:your-upstash-password@your-url.upstash.io:6380

# ════════════════════════════════════════════════════
# EMAIL — Resend is preferred; SMTP is the fallback if RESEND_API_KEY is unset
# ════════════════════════════════════════════════════
RESEND_API_KEY=re_xxx
RESEND_FROM=Safarnama <noreply@safarnama.store>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Safarnama <noreply@safarnama.in>
# Reply-To on every outgoing email — must be a real, monitored inbox
SUPPORT_EMAIL=support@safarnama.store

# ════════════════════════════════════════════════════
# SMS OTP (MSG91 — alternative to Firebase phone auth)
# ════════════════════════════════════════════════════
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# ════════════════════════════════════════════════════
# WHATSAPP (MSG91 — transactional + OTP + broadcasts)
# MSG91_WA_BUSINESS_NUMBER: exact value from MSG91 dashboard (includes country code)
# MSG91_WA_OTP_PREFER=true  → send OTP via WhatsApp instead of SMS
# Template names must be pre-approved in Meta Business Manager
# ════════════════════════════════════════════════════
MSG91_WA_BUSINESS_NUMBER=your-msg91-whatsapp-integrated-number
MSG91_WA_OTP_TEMPLATE=your-whatsapp-otp-template-name
MSG91_WA_OTP_PREFER=false
MSG91_WA_TPL_BOOKING_CONFIRMED=booking_confirmed
MSG91_WA_TPL_BOOKING_CANCELLED=booking_cancelled
MSG91_WA_TPL_PAYMENT_RECEIVED=payment_received
MSG91_WA_TPL_PAYMENT_FAILED=payment_failed
MSG91_WA_TPL_REFUND_PROCESSED=refund_processed
MSG91_WA_TPL_TRIP_REMINDER=trip_reminder
MSG91_WA_TPL_ORGANIZER_APPROVED=organizer_approved
MSG91_WA_TPL_ORGANIZER_REJECTED=organizer_rejected
MSG91_WA_TPL_TRIP_REQUEST_APPROVED=trip_request_approved
MSG91_WA_TPL_DOCUMENT_REUPLOAD_REQUIRED=document_reupload_required
MSG91_WA_TPL_WALLET_CREDIT_EXPIRING=wallet_credit_expiring
MSG91_WA_TPL_TRIP_TYPE_REQUEST_APPROVED=trip_type_request_approved

# ════════════════════════════════════════════════════
# PAYMENT GATEWAY SELECTION
# razorpay (default) | cashfree
# ════════════════════════════════════════════════════
PAYMENT_GATEWAY=razorpay

# ════════════════════════════════════════════════════
# PAYMENTS (Razorpay)
# ════════════════════════════════════════════════════
# Use live keys (rzp_live_*) in production
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Set this to the webhook secret from Razorpay dashboard — must NOT equal KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ════════════════════════════════════════════════════
# ORGANIZER PAYOUT STRATEGY
# route: Razorpay Route (linked accounts)
# razorpayx_payouts (default): RazorpayX Payouts (Contact -> Fund Account -> Payout)
#   Needs its OWN, separate signup/key-pair from the main Razorpay PG account above.
#   If PAYOUT_STRATEGY=razorpayx_payouts in production, the four RAZORPAYX_* vars
#   below are ALL required or the app fails to boot.
# ════════════════════════════════════════════════════
PAYOUT_STRATEGY=razorpayx_payouts
RAZORPAYX_KEY_ID=your-razorpayx-key-id
RAZORPAYX_KEY_SECRET=your-razorpayx-key-secret
RAZORPAYX_ACCOUNT_NUMBER=your-razorpayx-current-account-number
RAZORPAYX_WEBHOOK_SECRET=your-razorpayx-webhook-secret

# ════════════════════════════════════════════════════
# CASHFREE (full integration — only needed if PAYMENT_GATEWAY=cashfree)
# CASHFREE_ENV must be 'production' for live payments
# ════════════════════════════════════════════════════
# CASHFREE_APP_ID=your-cashfree-app-id
# CASHFREE_SECRET_KEY=your-cashfree-secret-key
# CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
# CASHFREE_ENV=production
# NEXT_PUBLIC_CASHFREE_ENV=production

# ════════════════════════════════════════════════════
# MEDIA (Cloudinary)
# ════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ════════════════════════════════════════════════════
# MONITORING (Sentry)
# ════════════════════════════════════════════════════
SENTRY_DSN=your-api-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=your-web-sentry-dsn
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Enables readable stack traces via source map upload to Sentry
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ════════════════════════════════════════════════════
# LEGAL (frontend display only)
# ════════════════════════════════════════════════════
NEXT_PUBLIC_CONTACT_EMAIL=support@safarnama.in
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@safarnama.in
# ⚠️  Update to a real person's name before going live (IT Rules 2021)
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Your Name Here

# ════════════════════════════════════════════════════
# SEO — Search Console Verification
# Google: https://search.google.com/search-console → Add property → HTML tag method
# Bing:   https://www.bing.com/webmasters → Add site → Meta tag method
# Bing verification is critical — ChatGPT cites Bing-indexed content.
# ════════════════════════════════════════════════════
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
